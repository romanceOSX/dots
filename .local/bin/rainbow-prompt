#!/usr/bin/env zsh
# Pure-zsh rewrite: no forked processes (previously id/hostname/sed/awk, 5-6
# execs on EVERY prompt render since this backs starship's custom.rainbow
# module). %n/%m/$PWD are zsh prompt-expansion builtins; zsh/mathfunc gives an
# in-process sin(), so the whole gradient runs as one already-running process.
zmodload zsh/mathfunc

user=${(%):-%n}
host=${(%):-%m}
cwd=${PWD/#$HOME/\~}
text="$user@$host $cwd"

n=${#text}
freq=$(( 2 * 3.14159265 / (n > 1 ? n : 1) * 0.6 ))

out=""
for (( i = 0; i < n; i++ )); do
  r=$(( int(sin(freq * i + 0) * 55 + 200) ))
  g=$(( int(sin(freq * i + 2) * 55 + 200) ))
  b=$(( int(sin(freq * i + 4) * 55 + 200) ))
  out+=$'\033'"[38;2;${r};${g};${b}m${text[i+1]}"
done
print -rn -- "${out}"$'\033[0m'
